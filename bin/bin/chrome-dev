#!/usr/bin/env bash
#
# chrome-dev - Launch dedicated Chrome instance for development
#
# This Chrome instance is separate from personal browsing and is used for:
# - OpenCode's Chrome DevTools MCP
# - nvim-DAP debugging
# - Development with persistent authentication
#
# Usage:
#   chrome-dev [URL]           - Launch Chrome with optional URL (default: http://localhost:5173)
#   chrome-dev --help          - Show this help
#   chrome-dev --reset         - Reset the dev profile (clears all data)
#   chrome-dev --restart       - Kill and relaunch dev Chrome
#   chrome-dev --stop          - Kill all dev Chrome processes
#   chrome-dev --status        - Check if dev Chrome is running
#

set -euo pipefail

# Configuration
CHROME_PROFILE="${CHROME_DEV_PROFILE:-$HOME/.chrome-dev-profile}"
DEBUG_PORT="${CHROME_DEBUG_PORT:-9222}"
DEFAULT_URL="${CHROME_DEV_URL:-http://localhost:5173}"
PID_FILE="${CHROME_DEV_PID_FILE:-${TMPDIR:-/tmp}/chrome-dev.pid}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Functions
show_help() {
    cat << EOF
chrome-dev - Launch dedicated Chrome for development

Usage:
  chrome-dev [URL]           Launch Chrome (default: $DEFAULT_URL)
  chrome-dev --help          Show this help
  chrome-dev --reset         Reset dev profile (clears all data)
  chrome-dev --restart       Kill and relaunch dev Chrome
  chrome-dev --stop          Kill all dev Chrome processes
  chrome-dev --status        Check if dev Chrome is running

Environment variables:
  CHROME_DEV_PROFILE         Profile location (default: ~/.chrome-dev-profile)
  CHROME_DEBUG_PORT          Remote debugging port (default: 9222)
  CHROME_DEV_URL             Default URL (default: http://localhost:5173)
  CHROME_DEV_PID_FILE        PID file (default: $PID_FILE)

Examples:
  chrome-dev                 Open localhost:5173
  chrome-dev http://localhost:3000
  chrome-dev --restart       Restart using the default URL
  chrome-dev --restart URL   Restart and open URL
  chrome-dev --stop          Stop Chrome when its window has already closed
  CHROME_DEBUG_PORT=9223 chrome-dev

EOF
}

dev_chrome_pid() {
    local pid=""

    if [[ -f "$PID_FILE" ]]; then
        pid=$(<"$PID_FILE")
        # `kill -0` checks the status; it does not kill the process.
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null \
            && ps -p "$pid" -o args= 2>/dev/null | grep -F -- "$CHROME_PROFILE" >/dev/null; then
            echo "$pid"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    # Support Chrome instances started by older versions without a PID file.
    pgrep -f -- "$CHROME_PROFILE" | head -n 1 || true
}

check_status() {
    local pid
    if pid=$(dev_chrome_pid) && [[ -n "$pid" ]]; then
        echo -e "${GREEN}✓${NC} Dev Chrome is running (PID: $pid)"
        echo -e "${BLUE}📁${NC} Profile: $CHROME_PROFILE"
        echo -e "${BLUE}🔌${NC} Debug port: $DEBUG_PORT"
        
        # Try to get version info
        if command -v curl &> /dev/null; then
            if curl -s "http://127.0.0.1:$DEBUG_PORT/json/version" &> /dev/null; then
                echo -e "${GREEN}✓${NC} Remote debugging is accessible"
            fi
        fi
        return 0
    else
        echo -e "${YELLOW}○${NC} Dev Chrome is not running"
        return 1
    fi
}

stop_chrome() {
    local pids pid
    pids=$(
        {
            # Include every Chrome process using this profile. The browser
            # leaves renderer/GPU processes behind surprisingly often.
            pgrep -f -- "$CHROME_PROFILE" || true
            dev_chrome_pid || true
        } | sort -nu
    )

    if [[ -z "$pids" ]]; then
        rm -f "$PID_FILE"
        return 0
    fi

    echo -e "${YELLOW}🛑${NC} Stopping dev Chrome (PIDs: $(tr '\n' ' ' <<< "$pids"))..."
    while read -r pid; do
        [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    done <<< "$pids"

    # give chrome up to 5 sec for close cleanly
    for _ in {1..20}; do
        local still_running=0
        while read -r pid; do
            if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                still_running=1
                break
            fi
        done <<< "$pids"
        [[ "$still_running" -eq 0 ]] && break
        sleep 0.25
    done

    while read -r pid; do
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            echo -e "${RED}⚠${NC} Chrome process $pid did not stop; killing it"
            kill -9 "$pid" 2>/dev/null || true
        fi
    done <<< "$pids"

    rm -f "$PID_FILE"
}

reset_profile() {
    if check_status &> /dev/null; then
        echo -e "${RED}✗${NC} Chrome is running. Please close it first."
        exit 1
    fi
    
    if [[ -d "$CHROME_PROFILE" ]]; then
        echo -e "${YELLOW}⚠${NC}  This will delete all data in the dev profile:"
        echo -e "   $CHROME_PROFILE"
        read -p "   Continue? [y/N] " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            rm -rf "$CHROME_PROFILE"
            echo -e "${GREEN}✓${NC} Dev profile reset successfully"
        else
            echo -e "${BLUE}○${NC} Cancelled"
        fi
    else
        echo -e "${BLUE}○${NC} Dev profile doesn't exist yet"
    fi
}

find_chrome() {
    local chrome_path=""
    
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS
        chrome_path="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        if [[ ! -x "$chrome_path" ]]; then
            echo -e "${RED}✗${NC} Chrome not found at: $chrome_path" >&2
            exit 1
        fi
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        # Linux - try multiple paths
        for path in /usr/bin/google-chrome /usr/bin/chromium /usr/bin/chromium-browser; do
            if [[ -x "$path" ]]; then
                chrome_path="$path"
                break
            fi
        done
        if [[ -z "$chrome_path" ]]; then
            echo -e "${RED}✗${NC} Chrome/Chromium not found" >&2
            echo -e "   Install with: sudo apt install google-chrome-stable" >&2
            exit 1
        fi
    else
        echo -e "${RED}✗${NC} Unsupported OS: $OSTYPE" >&2
        exit 1
    fi
    
    echo "$chrome_path"
}

launch_chrome() {
    local url="${1:-$DEFAULT_URL}"
    local chrome_path
    local running_pid
    
    # Check if already running
    if running_pid=$(dev_chrome_pid) && [[ -n "$running_pid" ]]; then
        echo -e "${YELLOW}⚠${NC}  Dev Chrome is already running (PID: $running_pid)"
        echo -e "   Profile: $CHROME_PROFILE"
        echo -e "   Use '${BLUE}chrome-dev --status${NC}' for details"
        exit 0
    fi
    
    chrome_path=$(find_chrome)
    
    echo -e "${BLUE}🚀${NC} Launching Chrome for development..."
    echo -e "${BLUE}📁${NC} Profile: $CHROME_PROFILE"
    echo -e "${BLUE}🔌${NC} Debug port: $DEBUG_PORT"
    echo -e "${BLUE}🌐${NC} URL: $url"
    echo ""
    
    # Launch Chrome
    "$chrome_path" \
        --user-data-dir="$CHROME_PROFILE" \
        --remote-debugging-port="$DEBUG_PORT" \
        --no-first-run \
        --no-default-browser-check \
        "$url" &> /dev/null &
    local chrome_pid=$!
    printf '%s\n' "$chrome_pid" > "$PID_FILE"
    
    # Wait a moment and check if it started
    sleep 1
    if dev_chrome_pid > /dev/null; then
        echo -e "${GREEN}✓${NC} Chrome launched successfully (PID: $chrome_pid)!"
        echo ""
        echo -e "${BLUE}💡${NC} This is your dedicated dev Chrome:"
        echo -e "   • Authenticate once and stay logged in"
        echo -e "   • Used by OpenCode, nvim-DAP, and other dev tools"
        echo -e "   • Completely separate from personal browsing"
        echo ""
        echo -e "${BLUE}💡${NC} Check status: ${GREEN}chrome-dev --status${NC}"
        echo -e "${BLUE}💡${NC} Reset profile: ${GREEN}chrome-dev --reset${NC}"
    else
        echo -e "${RED}✗${NC} Failed to launch Chrome"
        rm -f "$PID_FILE"
        exit 1
    fi
}

restart_chrome() {
    stop_chrome
    launch_chrome "${1:-$DEFAULT_URL}"
}

# Main
main() {
    case "${1:-}" in
        --help|-h)
            show_help
            ;;
        --status|-s)
            check_status
            ;;
        --reset)
            reset_profile
            ;;
        --restart)
            shift
            restart_chrome "$@"
            ;;
        --stop)
            stop_chrome
            ;;
        *)
            launch_chrome "$@"
            ;;
    esac
}

main "$@"
